import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv('students.csv')
df.dropna(inplace=True)

df.describe()
df.groupby('Gender')[['Math', 'English', 'Science']].mean()
df[df['Math'] > 90][['Name', 'Math']]

plt.hist(df['Math'], bins=10, color='skyblue', edgecolor='black')
plt.title('Distribution of Math Scores')
plt.xlabel('Score')
plt.ylabel('Number of Students')
plt.grid(True)
plt.show()

subjects = ['Math', 'English', 'Science']
averages = [df[sub].mean() for sub in subjects]
plt.bar(subjects, averages, color=['blue', 'green', 'red'])
plt.title('Average Scores by Subject')
plt.ylabel('Average Score')
plt.show()

subjects = ['Math', 'English', 'Science']
averages = [df[sub].mean() for sub in subjects]
plt.bar(subjects, averages, color=['blue', 'green', 'red'])
plt.title('Average Scores by Subject')
plt.ylabel('Average Score')
plt.show()

df['Grade'].value_counts().plot.pie(autopct='%1.1f%%')
plt.title('Grade Distribution')
plt.ylabel('')
plt.show()

df.to_csv('students_cleaned.csv', index=False)
